{
  "type": "CityJSONExtension",
  "name": "Timestamps",
  "uri": "https://example.com/extensions/timestamps.ext.json",
  "version": "1.0",
  "versionCityJSON": "2.0",
  "description": "Adds a list of named timestamps (e.g. start and end dates) as an attribute on city objects.",
  "definitions": {
    "timestampList": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "timestamp": { "type": "string", "format": "date-time" },
          "value": { "type": ["string", "number"] }
        },
        "required": ["id", "timestamp", "value"],
        "additionalProperties": false
      }
    }
  },
  "extraAttributes": {
    "Bridge": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BridgePart": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BridgeInstallation": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BridgeConstructiveElement": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BridgeRoom": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BridgeFurniture": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "Building": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BuildingPart": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BuildingInstallation": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BuildingConstructiveElement": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BuildingFurniture": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BuildingStorey": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BuildingRoom": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "BuildingUnit": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "CityFurniture": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "CityObjectGroup": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "LandUse": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "OtherConstruction": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "PlantCover": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "SolitaryVegetationObject": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "TINRelief": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "TransportSquare": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "Railway": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "Road": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "Tunnel": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "TunnelPart": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "TunnelInstallation": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "TunnelConstructiveElement": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "TunnelHollowSpace": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "TunnelFurniture": { "+timestamps": { "$ref": "#/definitions/timestampList" } },
    "WaterBody": { "+timestamps": { "$ref": "#/definitions/timestampList" } }
  }
}