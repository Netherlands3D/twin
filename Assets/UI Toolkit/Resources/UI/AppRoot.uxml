<ui:UXML 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:ui="UnityEngine.UIElements" 
    noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" 
    xmlns:nl3d="Netherlands3D.UI.Components"
    xmlns:nl3dP="Netherlands3D.UI.Panels"
    editor-extension-mode="False"  
>
    <ui:Style src="./AppRoot.uss"/>
    <!-- <ui:VisualElement name="ViewportEdge" class="viewport-edge">
         <ui:VisualElement name="Left" class="viewport-edge__left">
             <ui:VisualElement class="viewport-edge__gradient-side">
         </ui:VisualElement>
         <ui:VisualElement name="Top" class="viewport-edge__top"/>
         <ui:VisualElement name="Right" class="viewport-edge__right"/>
         <ui:VisualElement name="Bottom" class="viewport-edge__bottom"/>
         <ui:VisualElement name="TopLeft" class="viewport-edge__topleft"/>
         <ui:VisualElement name="TopRight" class="viewport-edge__topright"/>
         <ui:VisualElement name="BottemRight" class="viewport-edge__bottomright"/>
         <ui:VisualElement name="BottomLeft" class="viewport-edge__bottomleft"/>
    </ui:VisualElement> -->
    <ui:VisualElement name="App" picking-mode="Ignore" class="app">
        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement picking-mode="Ignore" name="LeftSection">
                <nl3d:HamburgerMenu/>
                <ui:VisualElement picking-mode="Ignore" class="app" style="flex-grow: 1; flex-direction: row;">
                    <nl3d:ToolbarMain/>
                    <nl3d:InspectorPanel name="Inspector" header-text="Label" toolbar-style="Normal"/>
                    <nl3dP:LegendPanel />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="MidSection" class="app__top-zone" picking-mode="Ignore">
                <nl3d:ToolbarToolbox picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="PropertiesZone" class="app__properties-zone">
                <nl3dP:SecondaryPropertiesPanel name="SecondaryPropertiesPanel" class="app__properties-zone-column"/>
                <nl3dP:PropertiesPanel name="PropertiesPanel" class="app__properties-zone-column"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomSection" picking-mode="Ignore" style="align-items: flex-end; flex-direction: row;">
            <nl3d:Footer/>
            <ui:VisualElement name="BottomTools" picking-mode="Ignore" style="flex-shrink: 0; flex-basis: auto;">
                <nl3d:ToolbarNavigation/>
                <ui:VisualElement name="CameraSlider"/>
            </ui:VisualElement>
            <nl3d:MapViewport/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
