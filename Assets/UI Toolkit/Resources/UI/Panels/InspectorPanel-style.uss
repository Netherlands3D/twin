.inspector {
    --inspector-bg-color: var(--color-white);
    --inspector-border-radius: var(--spacing-2);
    --inspector-width: 400px;
    --inspector-section-spacing: var(--spacing-3);
    --inspector-section-header-margin-top: var(--spacing-2);
    --inspector-section-header-spacing: var(--spacing-1);
   
    justify-content: space-between;
    flex-shrink: 0;
    flex-grow: 0;
    align-self: stretch;
    min-width: 320px;
    width: var(--inspector-width);
    max-width: 520px;
    margin: 0px;
    padding: var(--spacing-5);
    padding-top: var(--spacing-4);
    padding-right: var(--spacing-5);
    padding-bottom: var(--spacing-5);
    background-color: var(--inspector-bg-color);
    border-radius: var(--inspector-border-radius);
}

.inspector .inspector-header {
    flex-direction: row;
    flex-shrink: 0;
    align-content: stretch;
    align-items: center;
    margin-bottom: var(--spacing-5);
    padding: 0;
}

.inspector .inspector-header-title {
    flex-grow: 1;
    flex-shrink: 0;
}

.inspector .inspector-header-button-close {
    flex-grow: 0;
    flex-shrink: 0;
    width: var(--spacing-6);
    height: var(--spacing-6);
    align-items: center;
    flex-wrap: nowrap;
    align-content: center;
    border-width: 0;
    background-size: cover;
}
.inspector .inspector-header-button-close .icon {
    background-size: var(--spacing-6);
}

.inspector .inspector-content {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: var(--spacing-5);
    padding: 0px;
}

.inspector__section {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--inspector-section-spacing);
}

.inspector__section-header {
    -unity-font-style: bold;
    margin-top: var(--inspector-section-header-margin-top);
    margin-bottom: var(--inspector-section-header-spacing);
}

.inspector.active {
    display: flex;
}