.properties-panel {
    --properties-bg-color: var(--color-white);
    --properties-border-radius: var(--spacing-2);
    --properties-width: 400px;
    --properties-min-width: 320px;
    --properties-max-width: 520px;

    min-width: var(--properties-min-width);
    width: var(--properties-width);
    max-width: var(--properties-max-width);

    justify-content: space-between;
    flex-shrink: 0;
    flex-grow: 0;
    margin: 0 0 var(--spacing-20);
    padding: var(--spacing-5);
    padding-top: var(--spacing-4);
    background-color: var(--properties-bg-color);
    border-radius: var(--properties-border-radius);
}

.properties-panel .properties-panel__header {
    flex-direction: row;
    flex-shrink: 0;
    align-content: stretch;
    align-items: center;
    margin-bottom: var(--spacing-4);
    padding: 0;
}

.properties-panel .properties-panel__header-title {
    flex-grow: 1;
    flex-shrink: 0;
}

.properties-panel .properties-panel__header-button-close {
    flex-grow: 0;
    flex-shrink: 0;
    width: var(--spacing-6);
    height: var(--spacing-6);
    align-items: center;
    flex-wrap: nowrap;
    align-content: center;
    border-width: 0;
    background-size: cover;
}
.properties-panel .properties-panel__header-button-close .icon {
    background-size: var(--spacing-6);
}

.properties-panel .properties-panel__content {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 0;
}

.properties-panel.active {
    display: flex;
}

.properties-panel:disabled {
    display: none;
}