.dialog-panel {
    flex-direction: column;
    

    
    translate: -50% -50%;
    width: 380px;
    height: auto;
    background-color: var(--color-white);
    border-radius: var(--border-radius-md);
    padding: var(--spacing-4);
}

.dialog-panel__message {
    flex-grow: 1;   
    margin-bottom: 0;
}

.dialog-panel__buttons
{
    flex-direction: row;
}


