.location-search-panel {
    --field-spacing: var(--spacing-3);
    
    display: none;
    flex-direction: column;
    flex-wrap: nowrap;
    flex-shrink: 1;
    flex-grow: 1;
    padding: var(--spacing-3);
    opacity: 0;
}

.location-search-panel .auto-complete {
    margin-bottom: var(--field-spacing);
}

.location-search-panel__coordinates {
    flex-direction: column;
}

.location-search-panel__coordinates-row {
    flex-direction: row;
    align-items: stretch;
}

.number-field.location-search-panel__coordinate-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.number-field.location-search-panel__coordinate-field--x {
    margin-right: var(--field-spacing);
}

.location-search-panel__coordinate-field.invalid .unity-base-text-field__input {
    color: var(--color-warning);
}

.location-search-panel.active {
    display: flex;
    transition-property: opacity;
    transition-duration: 0.3s;
    opacity: 1;
}

