.dashboard-block-overview {
    flex-shrink: 0;
    min-width: 0;
}

.dashboard-block-overview .header__label {
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}

.dashboard-block-overview > .panel-divider {
    background-color: var(--color-blue-100);
    flex-grow: 0;
    margin-top: var(--spacing-2);
    margin-bottom: 0;
}

.dashboard-block-overview__empty {
    margin-top: var(--spacing-2);
}

.dashboard-block-overview__row {
    flex-direction: row;
    align-items: flex-start;
    padding: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-blue-100);
}

.dashboard-block-overview__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--spacing-2);
}

.dashboard-block-overview__value {
    flex-shrink: 0;
    white-space: nowrap;
    -unity-text-align: middle-right;
}
