.asset-library-panel {
    flex-wrap: nowrap;
    flex-shrink: 1;
    flex-grow: 1;
}

.asset-library-panel .breadcrumb {
    margin-bottom: var(--spacing-3);
    width: auto;
    height: auto;
}

.asset-library-panel.hidden { /* todo: move this to base class of all inspectors*/
    transition-property: opacity;
    transition-duration: 0.3s;
    opacity: 0;
}

.asset-library-panel__footer{
    margin-top: auto;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

