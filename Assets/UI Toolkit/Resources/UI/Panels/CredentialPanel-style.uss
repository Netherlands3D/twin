.credential-panel {
    display: none;    
}

.credential-panel.active 
{
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    flex-grow: 0;
    margin-top: var(--spacing-2);
    transition-property: opacity;
    transition-duration: 0.3s;
    opacity: 1;
}

.credential-panel__retry-button {
    align-self: flex-end;    
    padding-bottom: var(--spacing-2);
    margin-right: 0;
}

.credential-panel__message-title:disabled {
    display: none;
}

.credential-panel__message-title {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    margin-bottom: var(--spacing-3);
}

.credential-panel__message-title-update:disabled {
    display: none;
}

.credential-panel__message-title-update {   
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    margin-bottom: var(--spacing-3);
}

.credential-panel__message-title-text {
    color: var(--color-warning);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    white-space: normal;
    margin-left: var(--spacing-2);
}

.credential-panel__message-title-text-update {
    color: var(--color-text);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    white-space: normal;
}

.credential-panel__message {
    font-size: var(--font-size-base);
    -unity-font-definition: var(--nl3d-default-font);

    flex-grow: 0;
    flex-shrink: 0;
    margin-top: var(--spacing-2);
    margin-bottom: var(--spacing-2);
}

.credential-panel__key-field {
    flex-grow: 1;
    margin-left: var(--spacing-2);
}

