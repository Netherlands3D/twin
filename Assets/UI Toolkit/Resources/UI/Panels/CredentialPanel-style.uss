.credential-panel {
    /*display: none;*/
    flex-wrap: wrap;
    flex-shrink: 0;
    flex-grow: 0;
    margin-top: var(--spacing-2);
}

.credential-panel.secondary{
    display: flex;
    flex-shrink: 0;
    flex-grow: 0;
    background-color: red;
    transition-property: opacity;
    transition-duration: 0.3s;
    opacity: 1;
}

.credential-panel__retry-button {
    align-self: flex-end;
    padding-top: var(--spacing-2);
    padding-bottom: var(--spacing-2);
    margin-right: 0;
}

.credential-panel__message-title {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    margin-top: var(--spacing-4);
    margin-bottom: var(--spacing-4);
}

.credential-panel__message-title-text.secondary {
     color: var(--color-text);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    white-space: normal;
    margin-left: var(--spacing-2);
}

.credential-panel__message-title-text {
    color: var(--color-warning);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    white-space: normal;
    margin-left: var(--spacing-2);
}

.credential-panel__message {
    font-size: var(--font-size-base);
    -unity-font-definition: var(--nl3d-default-font);

    flex-grow: 0;
    flex-shrink: 0;
    margin-top: var(--spacing-2);
    margin-bottom: var(--spacing-2);
}

