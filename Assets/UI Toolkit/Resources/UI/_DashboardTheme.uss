.dashboard-theme {
    --color-dashboard-map-base: var(--color-blue-200);
    --color-dashboard-dwellings-low: #8ab39b;
    --color-dashboard-dwellings-medium: #589672;
    --color-dashboard-dwellings-high: #246e45;
    --color-dashboard-bvo-low: #fce8d8;
    --color-dashboard-bvo-medium: #f5b899;
    --color-dashboard-bvo-high: #e07040;
    --color-dashboard-segment-social: #4a78ad;
    --color-dashboard-segment-mid-rent: #254976;
    --color-dashboard-segment-free-sector: #102a49;
    --color-dashboard-phase-bbp: #b65649;
    --color-dashboard-phase-so: #a03c32;
    --color-dashboard-phase-vo: #81291f;
    --color-dashboard-phase-do: #5e1d18;
    --color-dashboard-phase-unavailable: var(--color-blue-900);
    --color-dashboard-category-business: #ed703e;
    --color-dashboard-category-office: #3e83c5;
    --color-dashboard-category-hospitality: #db3781;
    --color-dashboard-category-social: #36a180;
    --color-dashboard-category-retail: #a355cc;
    --color-dashboard-category-supermarket: #c7a12e;
    --color-dashboard-category-sport: #37c5a1;
    --color-dashboard-category-existing-office: #806044;
    --color-dashboard-category-home-office: #007c83;
    --color-dashboard-room-one: #9160a6;
    --color-dashboard-room-two: #78498e;
    --color-dashboard-room-three: #603673;
    --color-dashboard-room-four: #452451;
}
