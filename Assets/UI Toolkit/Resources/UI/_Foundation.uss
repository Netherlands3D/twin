@import url("_Theme.uss");

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

.hidden {
    display: none;
}

.text-wrapping {
    white-space: normal;
}

.text-base, 
.unity-label, 
.text-header {
    -unity-font-definition: var(--nl3d-default-font);
    font-size: var(--font-size-base);
    -unity-font-style: normal;
    color: var(--color-text);
    white-space: normal;
}

.text-header {
    -unity-font-definition: var(--nl3d-header-font);
    white-space: normal;
}

.inspector-header-title {
    -unity-font-definition: var(--nl3d-inspector-header-font);
    font-size: var(--font-size-lg);
    -unity-font-style: normal;
    color: var(--color-text);
    white-space: normal;
}

.vignette-edge {
    -unity-background-image-tint-color: var(--color-blue-900-alpha);
    position: absolute;
}
