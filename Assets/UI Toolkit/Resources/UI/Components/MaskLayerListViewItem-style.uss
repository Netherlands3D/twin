.mask-layer-list-view-item {
    align-items: center;
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: var(--spacing-1);
}

.mask-layer-list-view-item:hover {
    background-color: transparent;
}

.mask-layer-list-view-item .mask-layer-list-view-item__cell {
    margin-right: var(--spacing-3);
}

.layer-list-view-item__name-label{
    border-width: 0;
}