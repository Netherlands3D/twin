.map-viewport {
    position: relative;
    flex-shrink: 1;
    flex-grow: 1;
    align-items: flex-end;
    
    /* grenzen: voorkomt te klein/te groot */
    aspect-ratio: 1.6;
    min-width: 410px;
    max-width: 410px; /* TODO: test on different screensizes if this is to big */
    min-height: 256px;
    max-height: 256px; /* TODO: test on different screensizes if this is to big */

    transition-property: min-width, min-height, max-width, max-height;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    
    border-radius: var(--spacing-2);
    border-width: 0px;
    background-color: var(--color-white);
    overflow: hidden; 
}

.map-viewport__pin
{
    position: absolute;
    left: 0; 
    top: 0;
}

.map-viewport .map-viewport__pin.icon {
    width: var(--spacing-8);
    height: var(--spacing-8);
    background-image: var(--icon-locationpin);
    -unity-background-image-tint-color: var(--color-blue-700);
}

.map-viewport.expanded{
    min-width: 512px;
    max-width: 512px; /* TODO: test on different screensizes if this is to big */
    min-height: 512px;
    max-height: 512px; /* TODO: test on different screensizes if this is to big */
}

.map-viewport__controls {
    position: absolute;
    right: var(--spacing-2);
    bottom: var(--spacing-2);
    flex-direction: column;
}

.button.map-viewport__zoom-button{
    margin-top: var(--spacing-1);
}