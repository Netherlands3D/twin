.toolbar-toolbox {
    margin-left: 0;
    margin-top: 0;
    flex: 0 1 auto;
    align-items: center;
}

.toolbar-toolbox__group.unity-button-group {    
    flex-direction: row;
    height: 44px;
    min-height: 44px;
    max-height: 52px;
    margin: 0 var(--spacing-1) var(--spacing-3) var(--spacing-3);
    background-color: transparent;
}

.toolbar-toolbox__group .button {
    flex: 0 auto;
    margin-right: var(--spacing-2);
}