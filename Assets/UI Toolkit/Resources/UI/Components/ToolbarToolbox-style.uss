.toolbar-toolbox {
    margin-left: 0;
    margin-top: 0;
    flex: 0 1 auto;
    align-items: center;
}

.toolbar-toolbox__group.unity-button-group {    
    flex-direction: row;
    /*justify-content: center;*/
    /*align-content: flex-start;*/
    height: 44px;
    min-height: 44px;
    max-height: 52px;
    margin-left: var(--spacing-3);
    margin-top: 0px;
    margin-right: var(--spacing-1);
    margin-bottom: var(--spacing-3);
    background-color: transparent;
}

.toolbar-toolbox__group .button {
    flex-shrink: 0;
    flex-grow: 0;
    margin-right: var(--spacing-2);
}