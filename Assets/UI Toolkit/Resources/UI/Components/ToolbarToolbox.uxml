<ui:UXML 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:ui="UnityEngine.UIElements" 
    noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" 
    xmlns:nl3d="Netherlands3D.UI.Components"
    editor-extension-mode="False"  
    class="toolbar-toolbox"
>
    <nl3d:ToggleButtonGroupPassthrough name="ButtonGroup" class="toolbar-toolbox__group" picking-mode="Ignore">
        <nl3d:Button name="Dome" button-type="Transparent" button-style="IconOnly" icon="SurfaceDome" />
        <nl3d:Button name="Screenshot" button-type="Transparent" button-style="IconOnly" icon="Camera" />
    </nl3d:ToggleButtonGroupPassthrough>
</ui:UXML>