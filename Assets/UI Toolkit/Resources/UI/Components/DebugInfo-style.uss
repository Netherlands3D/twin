.debug-info {
    display: none;
    flex-shrink: 0;
    flex-grow: 0;
    align-items: flex-end;
    justify-content: flex-end;
    height: var(--spacing-6);
    margin: 0 var(--spacing-3) var(--spacing-1) 0;
}

.app--functionality-debug-info .debug-info {
    display: flex;
}

.debug-info__content {
    flex-direction: row;
    flex-shrink: 1;
    flex-grow: 0;
    flex-wrap: wrap-reverse;
    align-items: center;
}