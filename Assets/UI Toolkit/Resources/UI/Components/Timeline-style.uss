.timeline {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: stretch;
    min-width: 0;
}

.timeline__marks-viewport {
    background-color: white;
    flex-grow: 1;
    border-radius: 8px;
    border-width: 2px;
    border-color: #CCD7E4;
    height: 16px;
    overflow: hidden;
}

.timeline__marks-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.timeline__mark {
    position: absolute;
    top: 50%;
    width: 2px;
    height: 4px;
    background-color: #CCD7E4;
    translate: -50% -50%;
}

.timeline__mark--labeled {
    background-color: black;
}

.timeline__mark--primary   { height: 8px; }
.timeline__mark--secondary { height: 4px; }
.timeline__mark--tertiary  { height: 2px; }

.timeline__labels-viewport {
    flex-grow: 1;
    height: 30px;
    overflow: hidden;
}

.timeline__labels-container {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    bottom: 0;
}

.timeline__label {
    position: absolute;
    top: 50%;
    width: 100px;
    height: 100px;
    translate: -50% -50%;
    justify-content: center;
}

.timeline__label > .unity-label {
    -unity-text-align: middle-center;
    color: white;
    text-shadow: 0px 0px 2px rgba(0, 0, 0, 0.9);
}

.timeline__label--primary > .unity-label {
    -unity-font-style: bold;
}

.timeline__thumb-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}


.timeline__thumb {
    position: absolute;
    background-image: var(--image-timeline-scrubber-inactive);
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    background-size: contain;
    width: 22px;
    height: 29px;
    translate: -50% -15px;
}

.timeline__thumb--dragging {
    background-image: var(--image-timeline-scrubber-active);
}

.timeline__thumb-label {
    position: absolute;
    translate: -50% -55px;
    border-radius: 16px;
    border-width: 2px;
    border-color: #004091;
    background-color: #E5EBF2;
    height: 32px;
    flex-grow: 1;
    padding-left: 8px;
    padding-right: 8px;
}

.timeline__thumb-label > .unity-label {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: black;
    text-shadow: 0px 0px 2px rgba(0, 0, 0, 0.9);
    margin: 4px;
}

.timeline__thumb-label > .unity-label {
