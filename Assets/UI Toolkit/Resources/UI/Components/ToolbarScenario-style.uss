.toolbar-scenario {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 1;
    width: 100%;
    min-width: 0;
    max-width: 1920px;
    justify-content: center;
    align-items: flex-start;
}

.toolbar-scenario__label {
    flex-grow: 0;
    flex-shrink: 0;
    padding: 0;
    margin: 0 0 0 var(--spacing-2);
    min-height: var(--spacing-11);
    height: var(--spacing-11);
    color: var(--color-white);
    text-shadow: 1px 2px 0 var(--color-blue-900);
    -unity-text-align: middle-center;
}

.toolbar-scenario .divider {
    width: var(--spacing-0_5);
    height: auto;
    min-height: var(--spacing-7);
    margin: var(--spacing-2);
    background-color: var(--color-white);
    border-radius: 1px;
}

.toolbar-scenario__button-group {
    flex-grow: 0;
    flex-shrink: 1;
    margin: 0;
    min-width: 0;
    max-width: 100%;
    background-color: transparent;
}

.toolbar-scenario__button-group > .unity-base-field__input {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    align-content: flex-start;
}

.toolbar-scenario__button-group .toolbar-scenario__button {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: var(--spacing-28);
    max-width: 280px;
    min-height: var(--spacing-11);
    max-height: var(--spacing-15); 
    margin-right: var(--spacing-2);
    margin-bottom: var(--spacing-2);
}

.toolbar-scenario__button-group .toolbar-scenario__button > #Label {
    min-width: 0;
    max-height: var(--spacing-10);
    overflow: hidden;
    text-overflow: ellipsis;
}