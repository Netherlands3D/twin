<ui:UXML 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:ui="UnityEngine.UIElements" 
    noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" 
    xmlns:nl3d="Netherlands3D.UI.Components"
    xmlns:nl3dP="Netherlands3D.UI.Panels"
    editor-extension-mode="False"  
    class="default-hud"
>
    <ui:VisualElement class="app__content">
        <ui:VisualElement picking-mode="Ignore" class="default-hud__main-section">
            <ui:VisualElement picking-mode="Ignore" name="LeftSection" class="default-hud__left-section presentation-section--hidden">
                <ui:VisualElement picking-mode="Ignore" class="default-hud__left-header">
                    <nl3d:HamburgerMenu />
                    <nl3d:PinToggle name="LeftPresentationPin" value="true" class="presentation-section__pin" />
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="default-hud__inspector-zone">
                    <nl3d:ToolbarMain picking-mode="Ignore" />
                    <nl3d:InspectorPanel name="Inspector" header-text="Label" toolbar-style="Normal" />
                    <nl3dP:LegendPanel />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="TopSection" class="default-hud__top-section presentation-section--hidden" picking-mode="Ignore">
                <nl3d:ToolbarToolbox picking-mode="Ignore" />
                <nl3d:ToolbarScenario />
            </ui:VisualElement>
            <ui:VisualElement name="PropertiesZone" class="default-hud__properties-zone">
                <nl3dP:SecondaryPropertiesPanel name="SecondaryPropertiesPanel" class="default-hud__properties-zone-column"/>
                <nl3dP:PropertiesPanel name="PropertiesPanel" class="default-hud__properties-zone-column"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomSection" picking-mode="Ignore" class="default-hud__bottom-section presentation-section--hidden">
            <ui:VisualElement name="BottomInfo" picking-mode="Ignore" class="default-hud__bottom-info">
                <nl3d:DebugInfo />
                <nl3d:Footer />
            </ui:VisualElement>
            <ui:VisualElement name="PresentationControls" picking-mode="Ignore" class="default-hud__presentation-controls">
                <nl3d:PinToggle name="NavigationPresentationPin" value="true" class="presentation-section__pin" />
                <nl3d:Toggle name="Presentation" class="default-hud__presentation-button" toggle-type="transparent" toggle-style="IconOnly" icon="PresentationChart" tooltip="Presentatiemodus (H)" />
            </ui:VisualElement>
            <ui:VisualElement name="NavigationSection" picking-mode="Ignore" class="default-hud__navigation-section presentation-section">
                <ui:VisualElement name="BottomTools" picking-mode="Ignore" class="default-hud__bottom-tools">
                    <nl3d:ToolbarNavigation />
                    <ui:VisualElement name="CameraSlider" />
                </ui:VisualElement>
                <ui:VisualElement name="MinimapColumn" picking-mode="Ignore" class="default-hud__minimap-column">
                    <nl3d:MapViewport bottom-left="0, 300000" top-right="280000, 620000" layer-start-index="3" resize-on-hover="true" class="map-viewport--fixed-size" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PresentationRevealZones" picking-mode="Ignore" class="presentation-reveal-zones">
        <ui:VisualElement name="LeftRevealZone" picking-mode="Position" class="presentation-reveal-zone presentation-reveal-zone--left-section presentation-reveal-zone--active" />
        <ui:VisualElement name="TopRevealZone" picking-mode="Position" class="presentation-reveal-zone" />
        <ui:VisualElement name="BottomRevealZone" picking-mode="Position" class="presentation-reveal-zone" />
    </ui:VisualElement>
        

</ui:UXML>