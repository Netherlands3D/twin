.sun-dial {
    --sun-dial-width: 250px;
    --sun-dial-height: 125px; /* equals width x 0.5 */
    --sun-dial-track-padding: 20px;
    --sun-dial-width-minus-padding: 210px; /* equals width - 2 x track-padding */
    --sun-dial-sun-and-moon-size: 20%;
    --sun-dial-sun-and-moon-position-offset: -10%; /* equals sun-and-moon-size x 0.5 x -1 */
    
    width: var(--sun-dial-width);
    height: var(--sun-dial-height);
}

.sun-dial__mask {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding-top: var(--sun-dial-track-padding);
    padding-left: var(--sun-dial-track-padding);
    padding-right: var(--sun-dial-track-padding)
}

.sun-dial__track {
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_Functionalities/Sun/Sprites/SunDialArc.svg");
    background-repeat: no-repeat;
    background-position: 50% 50%;
    background-size: 100% 100%;
    -unity-background-image-tint-color: var(--color-blue-300);
}

.sun-dial__orbit {
    position: absolute;
    width: var(--sun-dial-width-minus-padding);
    height: var(--sun-dial-width-minus-padding);
    margin-bottom: -50%;

    transform-origin: center center;
}

.icon.sun-dial__moon,
.icon.sun-dial__sun {
    position: absolute;
    left: 50%;
    width: var(--sun-dial-sun-and-moon-size);
    height: var(--sun-dial-sun-and-moon-size);
    margin-left: var(--sun-dial-sun-and-moon-position-offset);
    background-color: white;
}

.icon.sun-dial__moon {
    top: 0;
    margin-top: var(--sun-dial-sun-and-moon-position-offset);
}

.icon.sun-dial__sun {
    bottom: 0;
    margin-bottom: var(--sun-dial-sun-and-moon-position-offset);
}

.sun-dial__horizon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    background-color: var(--color-blue-300);
}

