<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:nl3d="Netherlands3D.UI.Components" xmlns:nl3dP="Netherlands3D.UI.Panels" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="DashboardRoot" picking-mode="Ignore" class="dashboard-hud__body">
        <ui:VisualElement name="Sidebar" class="dashboard-hud__sidebar">
            <nl3d:ToggleSwitch name="DashboardViewSwitch" toggle-on-label-click="false" label="Faseweergave" class="dashboard-hud__phase-toggle"/>
            <ui:VisualElement class="panel-divider" picking-mode="Ignore"/>
            <nl3d:TextCallOut name="SidebarDataExplanation" class="dashboard-hud__data-explanation hidden"/>
            <nl3d:ScrollView name="Scrollview" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="ProgramOverviewContent">
                    <nl3dP:DashboardBlockOverview/>
                    <nl3d:RingChart name="HousingSegmentChart" title="Segmentverdeling woningen" icon="Tile" class="dashboard-hud__housing-chart dashboard-theme"/>
                    <nl3d:BarChart name="HousingBlockChart" title="Woningen per blok" icon="Tile" value-axis-label="Aantal woningen" minimum-step="1" compact-numbers="true" million-suffix=" mln" billion-suffix=" mld" class="dashboard-hud__housing-chart dashboard-theme"/>
                </ui:VisualElement>
                <ui:VisualElement name="PhaseProgressContent" class="hidden"/>
            </nl3d:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="HudMain" picking-mode="Ignore" class="dashboard-hud__main">
            <nl3d:DashboardHeader name="DashboardHeader"/>
            <ui:VisualElement name="DashboardMapArea" picking-mode="Ignore" class="dashboard-hud__map-area"/>
            <ui:VisualElement name="PhaseChangesPanel" class="dashboard-hud__phase-changes hidden">
                <nl3dP:DashboardPhaseComparisonPanel/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
