<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:nl3d="Netherlands3D.UI.Components" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False" class="toolbar-navigation">
    <ui:VisualElement name="FPV" tooltip="First Person view" class="toolbar-navigation__button toolbar-navigation__fpv">
        <nl3d:Icon image="Fpv" color="White"/>
    </ui:VisualElement>
    <nl3d:Button name="North" button-type="transparent" button-style="IconOnly" icon="NorthArrow" tooltip="Draai richting het Noorden" class="toolbar-navigation__button toolbar-navigation__compass"/>
    <nl3d:Toggle name="Perspective" toggle-type="transparent" toggle-style="IconOnly" icon="OrthogonalView" tooltip="Ortografisch / Perspectief Camera" class="toolbar-navigation__button"/>
</ui:UXML>
