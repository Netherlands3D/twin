/* body */

.dashboard-hud__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* Sidebar panel */

.dashboard-hud__sidebar {
    width: var(--inspector-width);
    min-width: var(--inspector-min-width);
    flex-shrink: 0;
    padding: var(--spacing-3);
    background-color: var(--color-white);
    border-width: var(--spacing-0_5);
    border-color: var(--color-blue-100);
}

.dashboard-hud__phase-toggle {
    margin: 0 var(--spacing-4);
    height: var(--spacing-8);
    border-width: 0;
}

/* Map area */

.dashboard-hud__main,
.dashboard-hud__map-area {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.dashboard-hud__phase-changes {
    height: var(--spacing-40);
    max-height: 40%;
    flex-shrink: 0;
    background-color: var(--color-white);
    border-width: var(--spacing-0_5);
    border-color: var(--color-blue-100);
}
