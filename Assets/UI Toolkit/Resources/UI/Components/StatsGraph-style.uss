.stats-graph {
	flex-direction: row;
	align-items: center;
	align-self: stretch;
	width: 100%;
	height: 32px;
}

.stats-graph__title {
	width: 35%;
	flex-shrink: 0;
	-unity-text-align: middle-left;
}

.stats-graph__graph {
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 80px;
	height: 100%;
	
	overflow: hidden;

	margin-left: var(--spacing-2);
	margin-right: var(--spacing-2);

	background-color: var(--color-blue-100);
	border-width: 1px;
	border-color: var(--color-blue-100);
	border-radius: var(--spacing-1);
}

.stats-graph__value {
	width: 25%;
	flex-shrink: 0;
	-unity-text-align: middle-right;
}