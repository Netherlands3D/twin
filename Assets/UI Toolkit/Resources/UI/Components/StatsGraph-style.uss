.stats-graph {
	flex-direction: row;
	align-items: center;
	align-self: stretch;
	width: 100%;
	height: 64px;
}

.stats-graph__title {
	width: 35%;
	height: 100%;
	flex-shrink: 0;

	overflow: hidden;
	text-overflow: ellipsis;
	-unity-text-align: middle-left;
}

.stats-graph__graph {
	min-width: 80px;
	height: 100%;
	flex-grow: 1;
	flex-shrink: 1;

	overflow: hidden;

	margin-left: var(--spacing-2);
	margin-right: var(--spacing-2);

	background-color: var(--color-blue-100);
	border-width: 1px;
	border-color: var(--color-blue-100);
	border-radius: var(--spacing-1);
}

.stats-graph__values {
	width: 20%;
	height: 100%;
	flex-shrink: 0;

	flex-direction: column;
	justify-content: center;
}

.stats-graph__value,
.stats-graph__range-value
{
	flex-grow: 0;
	flex-shrink: 0;

	margin-top: 0;
	margin-bottom: 0;
	padding-top: 0;
	padding-bottom: 0;
	
	-unity-text-align: middle-right;
}

.stats-graph__range-value {
	font-size: var(--font-size-xs);
	opacity: 0.5;
}