.textfield {
    --textfield-input-bg: var(--color-blue-100);
    --textfield-input-bg-hover: var(--color-blue-100);
    --textfield-input-border-color: var(--color-blue-200);
    --textfield-input-border-width: var(--spacing-0_5);
    --textfield-input-radius: var(--border-radius-md);
    --textfield-input-padding-x: var(--spacing-2);
    --textfield-input-padding-y: var(--spacing-1);
    --textfield-icon-size: var(--spacing-6);
    --textfield-icon-gap: var(--spacing-2);

    flex-shrink: 1;
    flex-grow: 1;
    flex-wrap: wrap;
    margin: 0;
    min-height: var(--spacing-8);
}

/* Built-in Unity label is hidden by default; only shown in the WithLabel variant */
.textfield > .unity-label {
    display: none;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.textfield.textfield-style-with-label > .unity-label {
    display: flex;
}

/* The actual text input element */
.textfield .unity-base-text-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-wrap: wrap;
    padding-left: var(--textfield-input-padding-x);
    padding-right: var(--textfield-input-padding-x);
    padding-top: var(--textfield-input-padding-y);
    padding-bottom: var(--textfield-input-padding-y);
    --unity-selection-color: var(--color-selection);
    background-color: var(--textfield-input-bg);
    border-color: var(--textfield-input-border-color);
    border-width: var(--textfield-input-border-width);
    border-radius: var(--textfield-input-radius);
}

.textfield .unity-base-text-field__input:hover {
    background-color: var(--textfield-input-bg-hover);
}

.textfield .unity-base-text-field__input--placeholder {
    color: var(--color-blue-300);
}

.textfield TextElement {
    overflow: hidden;
    padding: 0;
}

/* Disabled */
.textfield:disabled {
    opacity: 1;
}

.textfield:disabled .unity-base-text-field__input {
    background-color: var(--color-white);
    border-color: var(--color-blue-200);
}

.textfield:disabled .unity-base-text-field__input--placeholder {
    color: var(--color-blue-200);
}

.textfield:disabled TextElement {
    color: var(--color-blue-200);
}