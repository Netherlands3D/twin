.asset-library-listview-item {   

    transition-property: background-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-in;

    background-color: transparent;
}

.asset-library-listview-item__container{    
    
    margin-bottom: var(--spacing-2);
    display: flex;
    flex-direction: row;
    align-items: center;

     border-color:  var(--color-blue-200);
    border-width: 2px;
    border-radius:var(--spacing-2);
}

.asset-library-listview-item__container > * {
    align-items: stretch;
}

.asset-library-listview-item__container .icon {
    margin: var(--spacing-2);
}


/* .asset-library-listview-item__label {
    -unity-font-definition: var(--nl3d-default-font-semi-bold);
    margin: 0 var(--spacing-2) 0 0;
    padding: 0;
} 
 */

.asset-library-listview-item__container:hover{
    background-color: var(--color-blue-700-hover);
}

.asset-library-listview-item:checked .asset-library-listview-item__container{
    background-color:  var(--color-selection);
}