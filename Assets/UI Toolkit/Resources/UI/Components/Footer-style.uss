.footer {
    flex-direction: column;
    flex-shrink: 1;
    flex-grow: 1;
    align-self: flex-end;
    align-content: flex-end;
    min-height: var(--spacing-7);
    max-height: var(--spacing-11);
    margin-left: 0px;
    margin-top: 0px;
    margin-right: var(--spacing-3);
    margin-bottom: 0px;
    background-color: transparent;
}

.footer Label {
    color: var(--color-white);
}

.footer__divider {
    flex-grow: 0;
    flex-shrink: 0;
    height: var(--spacing-0_5);
    background-color: var(--color-blue-200);
    border-radius: 1px;

    /* ruimte tussen divider en content */
    margin-bottom: var(--spacing-1);
}

.footer__content {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    align-items: flex-end;
}

.footer__app-name {
    flex-shrink: 0;
    flex-grow: 0;
    margin: 0 var(--spacing-12) 0 0;
    padding: 0;
}

.footer__attribution {
    flex-shrink: 0;
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    white-space: normal; 
}