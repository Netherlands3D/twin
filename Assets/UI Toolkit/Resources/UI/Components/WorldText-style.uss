.world-text
{
    position:absolute;
}

.world-text > .editable-name-field{
    background-color: var(--color-white);
}

.world-text__position {
    border-radius: 20px;
    border-width: 5px;
    border-color: var(--color-black);
    background-color: var(--color-white);
    height: 20px;
    width: 20px;
    position:absolute;
    translate: -50% -50%;
}