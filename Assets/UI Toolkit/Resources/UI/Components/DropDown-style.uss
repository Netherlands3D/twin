.dropdown {
    width: 100%;
    min-height: var(--spacing-11);
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    border-width: var(--spacing-0_5);
    border-color: var(--color-blue-200);
    padding: var(--spacing-2);
    margin: 0;
    flex-direction: row-reverse;
    justify-content: flex-start;
    align-items: center;
    flex-shrink: 1;
    flex-grow: 0;
    min-width: 0;
}

.dropdown:hover {
    border-color: var(--color-blue-700);
}

.dropdown .unity-base-field__input {
    color: var(--color-text);
    background-color: transparent; 
    margin: 0;
    padding: 0;
    border-width: 0;
    min-width: var(--spacing-8);
    flex-basis: auto;
    flex-grow: 0;
    flex-shrink: 0;
}

.dropdown .unity-base-popup-field__arrow {
    background-image: var(--icon-chevrondown);
    width: var(--spacing-6);
    height: var(--spacing-6);
    margin-left: var(--spacing-2);
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-text);
}

.dropdown .unity-label{
    color: var(--color-text);
    -unity-text-align: middle-left;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dropdown:disabled {
    opacity: 1;
    background-color: var(--color-white);
    border-color: var(--color-blue-200);
}

.dropdown:disabled .unity-label {
    color: var(--color-blue-200);
}

.dropdown:disabled .unity-base-popup-field__arrow,
.dropdown:disabled .icon {
    -unity-background-image-tint-color: var(--color-blue-200);
}

.unity-base-dropdown__item{
    background-color: var(--color-white);
    border-color: var(--color-blue-700);
    border-left-width: var(--spacing-0_5);
    border-right-width: var(--spacing-0_5);
    padding: var(--spacing-2);
    align-items: stretch;
    flex-shrink: 1;
    flex-grow: 0;
    margin: 0;
    min-height: var(--spacing-11);
}

.unity-base-dropdown__item > .unity-label {
    color: var(--color-text);
    -unity-text-align: middle-left;
    white-space: normal;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.unity-base-dropdown__item.dropdown-popup-item__first-item {
    border-top-width: var(--spacing-0_5);
    border-top-left-radius: var(--border-radius-lg);
    border-top-right-radius: var(--border-radius-lg);

}

.unity-base-dropdown__item.dropdown-popup-item__last-item {
    border-bottom-width: var(--spacing-0_5);
    border-bottom-left-radius: var(--border-radius-lg);
    border-bottom-right-radius: var(--border-radius-lg);
}

.unity-base-popup-field__text {
    margin: 0;
    display: none;
}


.unity-base-dropdown__item:hover {
    background-color: var(--color-blue-700);
}

.unity-base-dropdown__item:hover .unity-label{    
    color: var(--color-white);
}

.unity-base-dropdown__item:hover .icon{
    -unity-background-image-tint-color: var(--color-white);
}

.unity-base-dropdown__container-outer .unity-repeat-button,
.unity-base-dropdown__container-outer .unity-scroll-view__vertical-scroller,
.unity-base-dropdown__container-outer .unity-scroll-view__horizontal-scroller,
.unity-base-dropdown__container-outer .unity-scroller__slider,
.unity-base-dropdown__container-outer .unity-scroller {
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    opacity: 0;
    display: none;
}

.unity-base-dropdown__container-outer{
    border-radius: var(--border-radius-lg);
    border-width: 0;
}

.unity-base-dropdown__container-outer > * {
    padding: 0;
    background-color: transparent;
}
