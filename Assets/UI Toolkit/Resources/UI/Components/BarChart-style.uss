.bar-chart {
    --bar-chart-plot-height: 200px;
    --bar-chart-column-width: 72px;
    --bar-chart-tick-width: 48px;
    --bar-chart-grid-color: var(--color-blue-100);
    flex-shrink: 0;
    min-width: 0;
    max-width: 100%;
    font-size: var(--font-size-base);
}

.bar-chart__title,
.bar-chart__description {
    white-space: normal;
}

.bar-chart__title {
    margin-bottom: var(--spacing-4);
}

.bar-chart__description {
    margin-bottom: var(--spacing-2);
}

.bar-chart__title > .header__label {
    flex-shrink: 1;
    min-width: 0;
}

.bar-chart__body {
    display: none;
    flex-direction: row;
    min-width: 0;
}

.bar-chart__axis {
    flex-direction: row;
    height: var(--bar-chart-plot-height);
    flex-shrink: 0;
    margin-right: var(--spacing-2);
}

.bar-chart__axis-title {
    width: var(--spacing-6);
    height: 100%;
    flex-shrink: 0;
    margin-right: var(--spacing-2);
}

.bar-chart__axis-label {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--bar-chart-plot-height);
    height: var(--spacing-6);
    translate: -50% -50%;
    rotate: -90deg;
    transform-origin: 50% 50%;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bar-chart__ticks {
    width: var(--bar-chart-tick-width);
    height: 100%;
    flex-shrink: 0;
}

.bar-chart__tick {
    position: absolute;
    right: 0;
    height: var(--spacing-6);
    margin-bottom: -12px;
    -unity-text-align: middle-right;
}

.bar-chart__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.bar-chart__scroll .unity-scroll-view__content-container {
    min-width: 100%;
}

.bar-chart__columns {
    flex-direction: row;
    flex-shrink: 0;
    min-width: 100%;
}

.bar-chart__column {
    width: var(--bar-chart-column-width);
    flex-grow: 1;
    flex-shrink: 0;
}

.bar-chart__plot {
    height: var(--bar-chart-plot-height);
    flex-shrink: 0;
}

.bar-chart__grid-line {
    position: absolute;
    left: 0;
    right: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--bar-chart-grid-color);
}

.bar-chart__stack {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--spacing-3);
    right: var(--spacing-3);
    flex-direction: column-reverse;
}

.bar-chart__segment {
    flex-shrink: 0;
}

.bar-chart__segment:hover {
    opacity: 0.8;
}

.bar-chart__total-anchor {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
    height: var(--spacing-6);
    margin-bottom: var(--spacing-3);
}

.bar-chart__total-label {
    height: var(--spacing-6);
    min-width: var(--spacing-8);
    max-width: 100%;
    padding: 0 var(--spacing-2);
    flex-shrink: 0;
    background-color: var(--color-white);
    border-width: var(--spacing-0_5);
    border-color: var(--color-blue-200);
    border-radius: var(--spacing-3);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bar-chart__category-label {
    height: var(--spacing-8);
    -unity-text-align: middle-center;
}

.bar-chart__legend {
    display: none;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--spacing-2);
}

.bar-chart__legend-entry {
    flex-direction: row;
    align-items: center;
    margin-right: var(--spacing-3);
    margin-bottom: var(--spacing-1);
}

.bar-chart__swatch {
    width: var(--spacing-3);
    height: var(--spacing-3);
    margin-right: var(--spacing-1);
}

.bar-chart__empty {
    white-space: normal;
}
