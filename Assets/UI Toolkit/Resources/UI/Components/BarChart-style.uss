@import url("Chart-style.uss");

.bar-chart {
    --bar-chart-plot-height: 200px;
    --bar-chart-column-width: 64px;
    --bar-chart-tick-width: 48px;
    --bar-chart-bar-thickness: 48px;
    --bar-chart-grid-color: var(--color-blue-100);
    flex-shrink: 0;
    min-width: 0;
    max-width: 100%;
    font-size: var(--font-size-base);
}

.bar-chart__title,
.bar-chart__description {
    white-space: normal;
}

.bar-chart__title {
    margin-bottom: var(--spacing-4);
}

.bar-chart__description {
    margin-bottom: var(--spacing-2);
}

.bar-chart__title > .header__label {
    flex-shrink: 1;
    min-width: 0;
}

.bar-chart__body {
    display: none;
    flex-direction: row;
    min-width: 0;
}

.bar-chart__axis {
    flex-direction: row;
    height: var(--bar-chart-plot-height);
    flex-shrink: 0;
    margin-right: var(--spacing-1);
}

.bar-chart__axis-title {
    width: var(--spacing-6);
    height: 100%;
    flex-shrink: 0;
    margin-right: 0;
}

.bar-chart__axis-label {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--bar-chart-plot-height);
    height: var(--spacing-6);
    margin: 0;
    padding: 0 0 var(--spacing-1) 0;
    translate: -50% -50%;
    rotate: -90deg;
    transform-origin: 50% 50%;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bar-chart__ticks {
    width: var(--bar-chart-tick-width);
    height: 100%;
    flex-shrink: 0;
}

.bar-chart__tick {
    position: absolute;
    right: 0;
    height: var(--spacing-6);
    margin-bottom: -12px;
    -unity-text-align: middle-right;
}

.bar-chart__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.bar-chart__scroll .unity-scroll-view__content-container {
    min-width: 100%;
}

.bar-chart__columns {
    flex-direction: row;
    flex-shrink: 0;
    min-width: 100%;
}

.bar-chart__column {
    width: var(--bar-chart-column-width);
    flex-grow: 1;
    flex-shrink: 0;
}

.bar-chart__plot {
    height: var(--bar-chart-plot-height);
    flex-shrink: 0;
}

.bar-chart__grid-line {
    position: absolute;
    left: 0;
    right: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--bar-chart-grid-color);
}

.bar-chart__stack {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: var(--bar-chart-bar-thickness);
    max-width: 100%;
    translate: -50% 0;
    flex-direction: column-reverse;
}

.bar-chart__segment {
    flex-shrink: 0;
}

.bar-chart__segment:hover {
    opacity: 0.8;
}

.bar-chart__total-anchor {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
    height: var(--spacing-6);
    margin-bottom: var(--spacing-3);
}

.bar-chart__category-label {
    min-height: var(--spacing-5);
    margin: var(--spacing-1) 0 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.bar-chart__total-label {
    padding-left: var(--spacing-1);
    padding-right: var(--spacing-1);
}

.bar-chart__scroll .unity-scroller--horizontal {
    margin-top: 0;
}

.bar-chart__empty {
    white-space: normal;
}

.bar-chart__horizontal-plot-area {
    display: none;
    min-width: 0;
}

.bar-chart--horizontal .bar-chart__body {
    flex-direction: column-reverse;
}

.bar-chart--horizontal .bar-chart__scroll {
    display: none;
}

.bar-chart--horizontal .bar-chart__horizontal-plot-area {
    display: flex;
}

.bar-chart--horizontal .bar-chart__columns {
    flex-direction: column;
    min-width: 0;
    width: 100%;
}

.bar-chart--horizontal .bar-chart__column {
    flex-direction: row-reverse;
    width: auto;
    height: var(--bar-chart-column-width);
    flex-grow: 0;
}

.bar-chart--horizontal .bar-chart__category-label {
    width: auto;
    max-width: 40%;
    height: 100%;
    min-width: 0;
    flex-shrink: 0;
    margin: 0;
    padding-right: var(--spacing-2);
    -unity-text-align: middle-left;
    overflow: hidden;
}

.bar-chart--horizontal .bar-chart__plot {
    height: 100%;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.bar-chart--horizontal .bar-chart__stack {
    top: 50%;
    bottom: auto;
    left: 0;
    right: 0;
    width: auto;
    height: var(--bar-chart-bar-thickness);
    translate: 0 -50%;
    flex-direction: row;
}

.bar-chart--horizontal .bar-chart__grid-line {
    top: 0;
    bottom: 0;
    left: auto;
    right: auto;
    width: 1px;
    border-bottom-width: 0;
    background-color: var(--bar-chart-grid-color);
}

.bar-chart--horizontal .bar-chart__total-anchor {
    top: 0;
    bottom: 0;
    left: auto;
    right: auto;
    height: auto;
    margin-bottom: 0;
    margin-left: var(--spacing-3);
    align-items: flex-start;
    justify-content: center;
}

.bar-chart--horizontal .bar-chart__axis {
    flex-direction: column-reverse;
    height: auto;
    margin-left: 0;
    margin-right: 0;
}

.bar-chart--horizontal .bar-chart__ticks {
    width: 100%;
    height: var(--spacing-6);
}

.bar-chart--horizontal .bar-chart__tick {
    right: auto;
    bottom: 0;
    translate: -50% 0;
    margin-bottom: 0;
    -unity-text-align: middle-center;
}

.bar-chart--horizontal .bar-chart__axis-title {
    width: 100%;
    height: var(--spacing-6);
    margin-right: 0;
}

.bar-chart--horizontal .bar-chart__axis-label {
    padding: 0;
    position: relative;
    left: auto;
    top: auto;
    width: 100%;
    rotate: 0deg;
    translate: 0 0;
}
