.default-hud{
    flex-grow: 1;
}

.default-hud__top-section {
    flex: 0 auto;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    align-items: center;
}

.default-hud__inspector-zone {
    flex-direction: row;
    flex-grow: 1;
}

.default-hud__properties-zone {
    position: absolute;
    right: 0;
    top: 0;
    flex-direction: row;
    max-height: 100%;
}

.default-hud__properties-zone .default-hud__properties-zone-column {
    margin-left: var(--spacing-2);
}

.default-hud__bottom-section {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-end;
}

.default-hud__bottom-info {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
}

.default-hud__bottom-tools {
    flex-shrink: 0;
}