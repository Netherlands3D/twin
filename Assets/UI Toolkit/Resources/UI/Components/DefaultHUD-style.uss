.default-hud{
    flex-grow: 1;
}

.default-hud__main-section {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
    min-width: 0;
}

.default-hud__left-section {
    flex-grow: 0;
    flex-shrink: 0;
    align-self: stretch;
}

.default-hud__top-section {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    min-width: 0;
    min-height: var(--spacing-14);
    align-items: center;
    overflow: hidden;
}

.default-hud__inspector-zone {
    flex-direction: row;
    flex-grow: 1;
}

.default-hud__properties-zone {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
    margin-left: auto;
    min-height: 0;
    max-height: 100%;
    padding-bottom: 224px;
}

.default-hud__properties-zone .default-hud__properties-zone-column {
    align-self: stretch;
    min-height: 0;
    max-height: 100%;
    margin-left: var(--spacing-2);
}

.default-hud__top-section > .toolbar-scenario {
    align-self: stretch;
    width: auto;
    margin-top: var(--spacing-3);
    margin-left: 484px;
    margin-right: 484px;
}

.default-hud__bottom-section {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
}

.default-hud__bottom-info {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
}

.default-hud__bottom-tools {
    flex-shrink: 0;
}

.default-hud__top-section > .toolbar-toolbox,
.default-hud__top-section > .toolbar-scenario {
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
}

.default-hud__left-header {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.presentation-section {
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
}

.default-hud__inspector-zone > .toolbar-main {
    align-self: flex-start;
}

.default-hud__navigation-section {
    position: relative;
    flex-direction: row;
    align-items: flex-end;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 0;

    transition-property: translate, margin-right;
    transition-duration: 0.25s, 0.15s;
    transition-timing-function: ease-in-out;
    transition-delay: 0.15s, 0s;
}

.default-hud__navigation-section.presentation-section--hidden {
    transition-duration: 0.40s, 0.15s;
    transition-delay: 0s, 0s;
}

.default-hud__minimap-column {
    flex-direction: column;
    align-items: flex-end;
    flex-grow: 0;
    flex-shrink: 0;
}

.default-hud__minimap-column > .map-viewport {
    flex-grow: 0;
    flex-shrink: 0;
}

.default-hud__presentation-controls {
    display: flex;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: flex-start;
    margin-right: var(--spacing-2);
}

.default-hud__presentation-button.toggle {
    flex: 0 0 auto;
    height: var(--spacing-11);
    margin: 0;
}

.presentation-section__pin,
.toolbar-toolbox__presentation-pin {
    display: none;
}

.app--functionality-presentation-mode .presentation-section__pin,
.app--functionality-presentation-mode .toolbar-toolbox__presentation-pin {
    display: flex;
}

.presentation-reveal-zones {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.presentation-reveal-zone {
    position: absolute;
    display: none;
}

.presentation-reveal-zone--active {
    display: flex;
}

.presentation-reveal-zone--left-section {
    left: 0;
    top: 0;
    bottom: 0;
    width: 12px;
}

.presentation-reveal-zone--top-section {
    left: 0;
    right: 0;
    top: 0;
    height: 12px;
}

.presentation-reveal-zone--bottom-section {
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
}

.presentation-reveal-zone--active {
    display: flex;
    background-color: rgba(255, 255, 0, 0.25);
}

.default-hud__left-section,
.default-hud__top-section,
.default-hud__bottom-section {
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.25s;
    transition-delay: 0s;
    transition-timing-function: ease-in-out;
}

.default-hud__left-section.presentation-section--hidden,
.default-hud__top-section.presentation-section--hidden,
.default-hud__bottom-section.presentation-section--hidden {
    transition-delay: 0.5s;
}

.default-hud__left-section.presentation-section--hidden {
    translate: -100% 0;
}

.default-hud__top-section.presentation-section--hidden {
    translate: 0 -100%;
}

.default-hud__bottom-section.presentation-section--hidden {
    translate: 0 100%;
}
    
